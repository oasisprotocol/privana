# Alchemy API Key for deposit verification (required)
# Used to access chain RPC nodes for deposit verification and sweep operations
# Get your API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key-here

# =============================================================================
# MoonPay On-Ramp Configuration
# =============================================================================

# MoonPay API keys for the fiat on-ramp (sign-url + webhook endpoints).
# If the keys are unset, on-ramp endpoints fail closed with 503.

# Signs widget URLs and authenticates MoonPay server API calls (sk_...).
# MOONPAY_SECRET_KEY=sk_test_...
#
# Signs provider-neutral Privana on-ramp intents. Generate a distinct key per
# environment with `openssl rand -hex 32`; keys must contain at least 32 ASCII
# characters and no whitespace or commas.
# ONRAMP_INTENT_SIGNING_KEY=
# During rotation, keep comma-separated old keys here for 365-day recovery.
# ONRAMP_INTENT_PREVIOUS_SIGNING_KEYS=
#
# Verifies Moonpay-Signature-V2 webhook signatures.
# MOONPAY_WEBHOOK_SECRET_KEY=wk_test_...
