API_HOST=0.0.0.0
API_PORT=8000
# INFO, not DEBUG: oasis-rofl-client DEBUG logs include full tx payloads pre-encryption.
LOG_LEVEL=INFO
ENVIRONMENT=development

CORS_ALLOWED_ORIGINS=https://testnet.honoroll.io,https://staging.testnet.honoroll.io,http://localhost:3000,https://privana-ui.pages.dev,https://app.testnet.privana.finance

ACCOUNTING_CONTRACT_ADDRESS=0x34D9E2263285129Ae04Ca1214216ebd861e64B6b

SAPPHIRE_CHAIN_ID=23295
SAPPHIRE_RPC_URL=https://testnet.sapphire.oasis.io

ACCOUNTING_GAS_LIMIT=500000
ACCOUNTING_GAS_PRICE='{"84532": 1000000000, "11155111": 20000000000, "23295": 100000000000}'
ACCOUNTING_TOKEN_INFO='[
  {"chain_id": 84532},
  {"chain_id": 84532, "token_address": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"},
  {"chain_id": 84532, "token_address": "0xD733D48f2a7F57D4559F98ae07f87Dab595E3523"},
  {"chain_id": 11155111},
  {"chain_id": 11155111, "token_address": "0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"},
  {"chain_id": 23295, "token_address": "0xF5f49fbBBD46C204b836d243995df72A61bC7ce7"}
]'

WITHDRAWAL_POLL_INTERVAL=12
WITHDRAWAL_RESOLUTION_TIMEOUT=60
MIN_WITHDRAWAL_GAS_BALANCE=10000000000000

JWT_EXPIRY_HOURS=12
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ISSUER=privana
JWT_AUDIENCE=privana

AUTH_TOKEN_STORAGE_DIR=.auth_tokens
SIWE_DOMAINS=https://api.testnet.privana.finance,https://app.testnet.privana.finance,https://testnet.honoroll.io,https://staging.testnet.honoroll.io,http://localhost:3000
SIWE_NONCE_EXPIRY_SECONDS=300
AUTH_TOKEN_VALIDITY_SECONDS=86400
AUTH_TOKEN_KEY_ID=auth_token_enc_seed.v2.key
AUTH_CLIENTS='[
  {
    "client_id":"demo-casino-staging",
    "display_name":"Demo Casino (Staging)",
    "audience":"demo-casino-staging",
    "redirect_uris": [
      "https://testnet.honoroll.io/auth/callback",
      "https://staging.testnet.honoroll.io/auth/callback",
      "http://localhost:3000/auth/callback"
    ]
  },
  {
    "client_id":"privana-ui",
    "display_name":"Privana UI",
    "audience":"privana-ui",
    "redirect_uris": [
      "http://localhost:3000/auth/callback",
      "https://privana-ui.pages.dev/auth/callback",
      "https://app.testnet.privana.finance/auth/callback"
    ]
  }
]'

AUTH_CODE_TTL_SECONDS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

AUTH_NONCE_RATE_LIMIT=30
AUTH_LOGIN_RATE_LIMIT=10
AUTH_AUTHORIZE_RATE_LIMIT=10
AUTH_TOKEN_RATE_LIMIT=20

TRUST_X_FORWARDED_FOR=false

# New purchases remain on MoonPay until the controlled deployment flip.
# ONRAMP_PROVIDER=moonpay

ONRAMP_INTENT_SIGNING_KEY_ID=onramp_intent_signing_key.v1.key
# ONRAMP_INTENT_PREVIOUS_SIGNING_KEY_IDS=

MOONPAY_API_BASE_URL=https://api.moonpay.com
MOONPAY_ALLOWED_HOSTS=app.testnet.privana.finance,buy-sandbox.moonpay.com
MOONPAY_ALLOWED_CURRENCY_CODES=usdc
MOONPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Transak staging is deliberately incomplete until the deployment owner sets
# the verified proxy-owned original-client-IP header. A browser-supplied header
# must be overwritten by the proxy before ONRAMP_PROVIDER is changed.
TRANSAK_API_BASE_URL=https://api-stg.transak.com
TRANSAK_GATEWAY_BASE_URL=https://api-gateway-stg.transak.com
TRANSAK_REFERRER_DOMAIN=app.testnet.privana.finance
# TRANSAK_CLIENT_IP_HEADER=X-Original-User-IP
TRANSAK_CRYPTO_CURRENCY_CODE=USDC
TRANSAK_NETWORK=base
TRANSAK_CHAIN_ID=84532
TRANSAK_TOKEN_ADDRESS=0xD733D48f2a7F57D4559F98ae07f87Dab595E3523
