{
  "name": "onchain-signer",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "lint:eslint": "eslint --ignore-path .gitignore --ext .ts",
    "lint:solhint": "solhint 'contracts/**/*.sol'",
    "lint:prettier": "prettier --cache --check --plugin=prettier-plugin-solidity --cache '*.json' '**/*.ts' '**/*.sol'",
    "lint": "npm-run-all lint:**",
    "format:eslint": "eslint --fix --ignore-path .gitignore --ext .ts",
    "format:solhint": "solhint --fix 'contracts/**/*.sol'",
    "format:prettier": "prettier --write --plugin=prettier-plugin-solidity '*.json' '**/*.ts' '**/*.sol'",
    "format": "npm-run-all format:**",
    "build": "hardhat compile",
    "check:size": "hardhat run scripts/check-bytecode-size.ts --no-compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage"
  },
  "devDependencies": {
    "@ethereumjs/trie": "^6.2.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-ignition": "^0.15.1",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.1",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.2",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@oasisprotocol/sapphire-contracts": "^0.2.14",
    "@oasisprotocol/sapphire-hardhat": "^2.22.2",
    "@oasisprotocol/sapphire-paratime": "^2.2.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/mocha": "^9.1.1",
    "chai": "^4.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^3.3.7",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.2",
    "typescript": "^4.8.4",
    "ethers": "^6.15.0",
    "rlp": "^3.0.0"
  },
  "overrides": {
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=5.0.0 <5.1.8": "5.1.8",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "bn.js@>=5.0.0 <5.2.3": "5.2.3",
    "bn.js@<4.12.3": "4.12.3",
    "ajv@<6.14.0": "6.14.0",
    "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
    "qs@>=6.7.0 <6.14.2": "6.14.2",
    "js-yaml@<3.14.2": "3.14.2",
    "js-yaml@>=4.0.0 <4.1.1": "4.1.1",
    "lodash@>=4.0.0 <4.17.23": "4.17.23",
    "diff@>=4.0.0 <4.0.4": "4.0.4",
    "diff@>=5.0.0 <5.2.2": "5.2.2",
    "axios@>=1.0.0 <1.13.5": "1.13.5",
    "fast-xml-parser@>=5.0.0 <5.3.8": "5.3.8",
    "serialize-javascript@<=7.0.2": "7.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "cbor": "^10.0.11",
    "solidity-rlp": "^2.0.8"
  }
}
