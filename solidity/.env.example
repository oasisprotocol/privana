# Deployer EOA private key. Falls back to a public test mnemonic if unset —
# do NOT broadcast against a live network with the fallback.
PRIVATE_KEY=0x

# Base Sepolia RPC. Defaults to https://sepolia.base.org (rate-limited).
BASE_SEPOLIA_RPC_URL=

# Ethereum Sepolia RPC. Used only by directWithdraw/emergencyWithdraw tasks.
# Defaults to https://eth-sepolia.public.blastapi.io.
ETH_SEPOLIA_RPC_URL=

# Accounting proxy on sapphire-testnet. Required by deploy-bridge and bridge
# admin tasks (or pass --accounting <addr>). Populated by the deploy task.
ACCOUNTING_ADDRESS_SAPPHIRE=
