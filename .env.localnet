# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
# Optional comma-separated extra CORS origins for browser access.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Accounting contract configuration (required)
ACCOUNTING_CONTRACT_ADDRESS=0xA7918D253764E42d60C3ce2010a34d5a1e7C1398

# Sapphire Testnet configuration
SAPPHIRE_CHAIN_ID=23293
SAPPHIRE_RPC_URL=http://localhost:8545

# Optional: private key to sign Sapphire confidential view calls (hex; 0x optional).
# If unset, the service tries to use the ROFL appd keypair.
# SAPPHIRE_VIEW_PRIVATE_KEY=0x...

# Sapphire Mainnet configuration (uncomment to use)
# SAPPHIRE_CHAIN_ID=23294
# SAPPHIRE_RPC_URL=https://sapphire.oasis.io

# Gas configuration
ACCOUNTING_GAS_LIMIT=500000

# Per-chain gas price (wei) for sweep/gas-funding transactions, as a JSON object
# mapping chain_id to gas price. Published on-chain via setGasPrice at every ROFL
# restart (see services/gas_price_bootstrap.py). Omit a chain to leave its
# on-chain gas price untouched.
ACCOUNTING_GAS_PRICE='{"84532": 1000000000, "11155111": 20000000000, "23293": 100000000000}'

# Tokens to register on-chain via setTokenInfo at every ROFL restart (see
# services/token_info_bootstrap.py), as a JSON array. Native tokens for Base
# Sepolia (84532) and Ethereum Sepolia (11155111), plus Circle's official
# testnet USDC on each chain, plus the localnet ERC20 (LHONOR) on sapphire-localnet
# itself (23293) — the same-chain path where the accounting chain doubles as the
# deposit source chain, mirroring HONOR on Sapphire testnet (23295).
#
# The 23293 address is deterministic, not arbitrary: `hardhat deploy --network
# sapphire-localnet` deploys contracts/test/LocalnetERC20.sol from a fixed
# well-known burner key at nonce 0 (tasks/localnetToken.ts), and a CREATE address
# is keccak256(rlp([deployer, nonce]))[12:] — independent of bytecode. So it
# survives every localnet reset and this entry never rots. If the deploy task
# reports a different address, the two must be changed together.
ACCOUNTING_TOKEN_INFO='[
  {"chain_id": 84532},
  {"chain_id": 84532, "token_address": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"},
  {"chain_id": 11155111},
  {"chain_id": 11155111, "token_address": "0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"},
  {"chain_id": 23293, "token_address": "0x5FbDB2315678afecb367f032d93F642f64180aa3"}
]'

# Background service configuration
WITHDRAWAL_POLL_INTERVAL=12

MIN_WITHDRAWAL_GAS_BALANCE=10000000000000

WITHDRAWAL_RESOLUTION_TIMEOUT=60

# =============================================================================
# JWT Authentication Configuration
# =============================================================================

# JWT token expiration time in hours (default: 12)
JWT_EXPIRY_HOURS=12

# Refresh token expiration time in days (default: 7)
JWT_REFRESH_EXPIRY_DAYS=7

# JWT issuer claim - identifies who issued the token (default: privana)
JWT_ISSUER=privana

# JWT audience claim - identifies intended recipients (default: privana)
JWT_AUDIENCE=privana

# =============================================================================
# SIWE / AuthToken Configuration
# =============================================================================

# SIWE domain allow-list for authentication (required).
# Comma-separated list of domains accepted as the ``domain`` field in SIWE messages.
# Each entry is either a bare host[:port] or a full origin. If you include http://,
# the host must be loopback-only (localhost, 127.0.0.1, ::1).
# All configured origins are added to the CORS allow-list. The first entry is
# treated as the primary domain and is used only by code paths that do not
# involve a user-signed SIWE message: the hosted auth page served by this
# service, and server-minted private-read AuthTokens.
SIWE_DOMAINS=http://localhost:8000

# Directory for storing auth tokens, nonces, auth codes, and refresh token state (default: .auth_tokens)
# Uses SQLite via diskcache for process-safe storage
# AUTH_TOKEN_STORAGE_DIR=.auth_tokens

# SIWE nonce expiration time in seconds (default: 300 = 5 minutes)
# Bounds the window for SIWE message replay at the API level
# SIWE_NONCE_EXPIRY_SECONDS=300

# Auth token validity period in seconds (default: 86400 = 24 hours)
# This is the lifetime of SIWE-based auth tokens for contract view calls
AUTH_TOKEN_VALIDITY_SECONDS=86400

# Auth client registry

# Static client registry for popup/redirect auth flows.
# Each client defines a user-visible display name, exact allowed redirect_uris,
# and an optional id-token audience. If omitted, audience defaults to client_id.
AUTH_CLIENTS='[{"client_id":"casino-dev","display_name":"Casino (Dev)","audience":"casino-dev","redirect_uris":["http://localhost:3000/auth/callback"]}]'

# Short-lived authorization code lifetime in seconds (default: 120)
AUTH_CODE_TTL_SECONDS=120

# Shared auth rate-limit window in seconds (default: 60)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Per-IP auth endpoint request caps per window.
AUTH_NONCE_RATE_LIMIT=30
AUTH_LOGIN_RATE_LIMIT=10
AUTH_AUTHORIZE_RATE_LIMIT=10
AUTH_TOKEN_RATE_LIMIT=20

# Trust the first X-Forwarded-For IP for auth rate limiting (default: false).
# Enable only behind a trusted reverse proxy that rewrites this header.
TRUST_X_FORWARDED_FOR=false

# =============================================================================
# On-Ramp Configuration
# =============================================================================

# One provider launches new purchases per deployment. Keep MoonPay selected
# until the controlled Transak flip.
ONRAMP_PROVIDER=moonpay

# MoonPay API keys for the fiat on-ramp (sign-url + webhook endpoints).
# If the keys are unset, on-ramp endpoints fail closed with 503.
# MOONPAY_API_KEY is the publishable key (pk_...) expected in widget URLs.
# MOONPAY_API_KEY=pk_test_...
# MOONPAY_SECRET_KEY signs MoonPay widget URLs and authenticates server API calls.
# MOONPAY_SECRET_KEY=sk_test_...
# ROFL key ID for provider-neutral signed on-ramp intents.
ONRAMP_INTENT_SIGNING_KEY_ID=onramp_intent_signing_key.v1.key
# Previous key IDs retained for 365 days after their last mint.
# ONRAMP_INTENT_PREVIOUS_SIGNING_KEY_IDS=
# MOONPAY_WEBHOOK_SECRET_KEY=...

# MoonPay server API base URL used for transaction lookup.
MOONPAY_API_BASE_URL=https://api.moonpay.com

# Comma-separated MoonPay widget hosts accepted by /onramp/sign-url
MOONPAY_ALLOWED_HOSTS=buy.moonpay.com,buy-sandbox.moonpay.com

# Comma-separated MoonPay currency codes accepted in widget URLs
MOONPAY_ALLOWED_CURRENCY_CODES=usdc,usdc_base,usdc_base_sepolia

# Max age in seconds for webhook signature timestamps; 0 disables the check
# (default: 300)
MOONPAY_WEBHOOK_TOLERANCE_SECONDS=300

# Transak staging endpoints and the one supported BUY asset. Transak routes
# remain fail-closed until every setting, both credentials, an approved
# referrer, and a trusted proxy-owned client-IP header are configured.
# TRANSAK_API_KEY=...
# TRANSAK_API_SECRET=...
TRANSAK_API_BASE_URL=https://api-stg.transak.com
TRANSAK_GATEWAY_BASE_URL=https://api-gateway-stg.transak.com
# TRANSAK_REFERRER_DOMAIN=approved.example
# TRANSAK_CLIENT_IP_HEADER=X-Original-User-IP
TRANSAK_CRYPTO_CURRENCY_CODE=USDC
TRANSAK_NETWORK=base
TRANSAK_CHAIN_ID=84532
TRANSAK_TOKEN_ADDRESS=0xD733D48f2a7F57D4559F98ae07f87Dab595E3523

# =============================================================================
# TEE / ROFL Key Management
# =============================================================================

# TODO: Remove DISABLE_ROFL_KEYS when Sapphire localnet e2e tests are available.
# Set to "1" to disable ROFL-derived keys (for local development/testing)
# When disabled:
#   - JWT signing uses randomly generated Ed25519 keys (not persistent across restarts)
#   - AuthToken encryption uses deterministic test key (bytes32(1))
#   - On-ramp intent signing uses publicly derivable local keys; never use this in production
# In production (ROFL TEE), keys are derived from TEE-bound seeds for persistence
# DISABLE_ROFL_KEYS=1
