# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
# Optional comma-separated extra CORS origins for browser access.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://casino.flexvaults.com

# Accounting contract configuration (required)
ACCOUNTING_CONTRACT_ADDRESS=0xYourContractAddressHere

# Alchemy API Key for proof generation (required)
# Used to access archive nodes with debug_getRawBlock API support
# Get your API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Sapphire Testnet configuration
SAPPHIRE_CHAIN_ID=23295
SAPPHIRE_RPC_URL=https://testnet.sapphire.oasis.io

# Optional: private key to sign Sapphire confidential view calls (hex; 0x optional).
# If unset, the service tries to use the ROFL appd keypair.
# SAPPHIRE_VIEW_PRIVATE_KEY=0x...

# Sapphire Mainnet configuration (uncomment to use)
# SAPPHIRE_CHAIN_ID=23294
# SAPPHIRE_RPC_URL=https://sapphire.oasis.io

# Gas configuration
ACCOUNTING_GAS_LIMIT=500000

# Background service configuration
DEPOSIT_POLL_INTERVAL=1
WITHDRAWAL_POLL_INTERVAL=12

# =============================================================================
# JWT Authentication Configuration
# =============================================================================

# JWT token expiration time in hours (default: 12)
# JWT_EXPIRY_HOURS=12

# Refresh token expiration time in days (default: 7)
# JWT_REFRESH_EXPIRY_DAYS=7

# JWT issuer claim - identifies who issued the token (default: flexvaults)
# JWT_ISSUER=flexvaults

# JWT audience claim - identifies intended recipients (default: flexvaults)
# JWT_AUDIENCE=flexvaults

# =============================================================================
# SIWE / AuthToken Configuration
# =============================================================================

# SIWE domain allow-list for authentication (required).
# Comma-separated list of domains accepted as the ``domain`` field in SIWE messages.
# Each entry is either a bare host[:port] or a full origin. If you include http://,
# the host must be loopback-only (localhost, 127.0.0.1, ::1).
# All configured origins are added to the CORS allow-list. The first entry is
# treated as the primary domain and is used only by code paths that do not
# involve a user-signed SIWE message: the hosted auth page served by this
# service, and server-minted private-read AuthTokens.
SIWE_DOMAINS=http://localhost:8000

# Optional: restrict accepted SIWE chain IDs.
# Supports comma-separated decimal or hex values (e.g. 23295,0x5afe).
# If unset, defaults to configured RPC chains plus the Sapphire chain ID.
# SIWE_ALLOWED_CHAIN_IDS=23295

# Directory for storing auth tokens, nonces, auth codes, and refresh token state (default: .auth_tokens)
# Uses SQLite via diskcache for process-safe storage
# AUTH_TOKEN_STORAGE_DIR=.auth_tokens

# SIWE nonce expiration time in seconds (default: 300 = 5 minutes)
# Bounds the window for SIWE message replay at the API level
# SIWE_NONCE_EXPIRY_SECONDS=300

# Auth token validity period in seconds (default: 86400 = 24 hours)
# This is the lifetime of SIWE-based auth tokens for contract view calls
# AUTH_TOKEN_VALIDITY_SECONDS=86400

# Auth client registry

# Static client registry for popup/redirect auth flows.
# Each client defines a user-visible display name, exact allowed redirect_uris,
# and an optional id-token audience. If omitted, audience defaults to client_id.
# AUTH_CLIENTS='[{"client_id":"casino-dev","display_name":"Casino (Dev)","audience":"casino-dev","redirect_uris":["http://localhost:3000/auth/callback"]}]'

# Short-lived authorization code lifetime in seconds (default: 120)
# AUTH_CODE_TTL_SECONDS=120

# Shared auth rate-limit window in seconds (default: 60)
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Per-IP auth endpoint request caps per window.
# AUTH_NONCE_RATE_LIMIT=30
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_AUTHORIZE_RATE_LIMIT=10
# AUTH_TOKEN_RATE_LIMIT=20

# Trust the first X-Forwarded-For IP for auth rate limiting (default: false).
# Enable only behind a trusted reverse proxy that rewrites this header.
# TRUST_X_FORWARDED_FOR=false

# =============================================================================
# TEE / ROFL Key Management
# =============================================================================

# TODO: Remove DISABLE_ROFL_KEYS when Sapphire localnet e2e tests are available.
# Set to "1" to disable ROFL-derived keys (for local development/testing)
# When disabled:
#   - JWT signing uses randomly generated Ed25519 keys (not persistent across restarts)
#   - AuthToken encryption uses deterministic test key (bytes32(1))
# In production (ROFL TEE), keys are derived from TEE-bound seeds for persistence
# DISABLE_ROFL_KEYS=1
