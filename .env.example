# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Accounting contract configuration (required)
ACCOUNTING_CONTRACT_ADDRESS=0xYourContractAddressHere

# Alchemy API Key for proof generation (required)
# Used to access archive nodes with debug_getRawBlock API support
# Get your API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Sapphire Testnet configuration
SAPPHIRE_CHAIN_ID=23295
SAPPHIRE_RPC_URL=https://testnet.sapphire.oasis.io

# Optional: private key to sign Sapphire write transactions directly (hex; 0x optional).
# When set, bypasses ROFL daemon — useful for local dev and testing.
# The address of this key must be set as fdcRelayer on the Accounting contract.
# SAPPHIRE_PRIVATE_KEY=0x...

# Optional: private key to sign Sapphire confidential view calls (hex; 0x optional).
# If unset, the service tries to use the ROFL appd keypair.
# SAPPHIRE_VIEW_PRIVATE_KEY=0x...

# Sapphire Mainnet configuration (uncomment to use)
# SAPPHIRE_CHAIN_ID=23294
# SAPPHIRE_RPC_URL=https://sapphire.oasis.io

# Flare FDC configuration (required for FDC deposit path)
# COSTON2_PRIVATE_KEY must have C2FLR balance to pay attestation fees (~0.5 C2FLR/deposit).
# When unset, FDC path is disabled and legacy Merkle proof path is used instead.
# COSTON2_PRIVATE_KEY=0x...
# COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# FDC_VERIFIER_BASE_URL=https://fdc-verifiers-testnet.flare.network/
# FDC_DA_LAYER_URL=https://ctn2-data-availability.flare.network/
# FDC_API_KEY=00000000-0000-0000-0000-000000000000
#
# Source chain → FDC identifier mapping (JSON). Defaults to testnet (testETH on Sepolia).
# Mainnet example: FDC_SOURCE_IDS={"1":"ETH","8453":"base"}
# FDC_SOURCE_IDS={"11155111":"testETH"}
#
# Required confirmations for FDC attestation (default: 1 for testnet, increase for mainnet)
# FDC_REQUIRED_CONFIRMATIONS=1
#
# Timing overrides (rarely needed; defaults match Coston2/Flare mainnet):
# FDC_VOTING_EPOCH_DURATION_S=90
# FDC_FIRST_VOTING_ROUND_START_TS=1658430000
# FDC_INITIAL_PROOF_DELAY_S=95
# FDC_MAX_WAIT_S=600

# Gas configuration
ACCOUNTING_GAS_LIMIT=500000

# Background service configuration
DEPOSIT_POLL_INTERVAL=1
WITHDRAWAL_POLL_INTERVAL=12
