# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Accounting contract configuration (required)
ACCOUNTING_CONTRACT_ADDRESS=0xYourContractAddressHere

# Sapphire Testnet configuration
SAPPHIRE_CHAIN_ID=23295
SAPPHIRE_RPC_URL=https://testnet.sapphire.oasis.io

# Sapphire Mainnet configuration (uncomment to use)
# SAPPHIRE_CHAIN_ID=23294
# SAPPHIRE_RPC_URL=https://sapphire.oasis.io

# Gas configuration
ACCOUNTING_GAS_LIMIT=500000

# Deposit listener configuration
DEPOSIT_POLL_INTERVAL=12
